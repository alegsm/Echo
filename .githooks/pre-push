#!/usr/bin/env bash
# Scan outgoing commits for secrets before each push.
# Enable once per clone:
#   git config core.hooksPath .githooks
# Requires gitleaks on PATH (brew install gitleaks). Uses git mode and the
# repository's .gitleaks.toml when present. An unresolvable commit range,
# detected secret or scanner error blocks the push.
set -euo pipefail
command -v gitleaks >/dev/null || { echo "pre-push: gitleaks not installed (brew install gitleaks)" >&2; exit 1; }
zero=0000000000000000000000000000000000000000
cfg=(); [ -f .gitleaks.toml ] && cfg=(--config .gitleaks.toml)
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # branch deletion, nothing to scan
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="${remote_sha}..${local_sha}"
  else
    range="$local_sha"                                        # new branch or unknown remote tip: scan the whole ancestry
  fi
  count=$(git rev-list --count "$range" 2>/dev/null) || { echo "pre-push: cannot resolve $range; fetch origin and retry" >&2; status=1; continue; }
  [ "$count" -gt 0 ] || continue
  echo "pre-push: scanning $count commit(s) ($range)"
  if ! gitleaks git . ${cfg[@]+"${cfg[@]}"} --log-opts="$range --diff-merges=first-parent" --no-banner --exit-code 1; then
    echo "pre-push: secret scan failed or found leaks in $range" >&2; status=1
  fi
done
exit $status
