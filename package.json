{
  "name": "echo",
  "version": "0.4.0",
  "private": true,
  "description": "Lightweight desktop dictation app.",
  "license": "MIT",
  "author": "Alejandro Sanchez",
  "homepage": "https://echostt.app",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "windows:build": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "1.4.4",
    "happy-dom": "21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "8.3.6"
  }
