{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "version": "0.3.2",
  "identifier": "app.echostt.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Echo Overlay",
        "label": "overlay",
        "url": "/?surface=overlay",
        "width": 80,
        "height": 80,
        "minWidth": 80,
        "minHeight": 80,
        "maxWidth": 420,
        "maxHeight": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "title": "Echo Dashboard",
        "label": "dashboard",
        "url": "/?surface=dashboard",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; media-src 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'none'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; font-src 'self'; img-src 'self' data:; media-src 'none'; object-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Alejandro Sanchez",
    "copyright": "Copyright (c) 2026 Alejandro Sanchez",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"]
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    }
  }
}
